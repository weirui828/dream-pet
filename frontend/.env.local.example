NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Optional: bake the admin token into the build (otherwise paste it on the Settings screen)
# WARNING: NEXT_PUBLIC_* values end up in the browser JavaScript. Anyone who can load the web UI
# can read this token. Only set it for a UI that is reachable from your own machine.
# NEXT_PUBLIC_ADMIN_TOKEN=
